    "event.cancel.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The event will be marked cancelled for everyone after sync. Its details are kept. Guests can no longer respond. Existing calendar copies won’t be updated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El evento aparecerá como cancelado para todos después de sincronizar. Se conservarán sus detalles. Los invitados ya no podrán responder. Las copias del calendario no se actualizarán."
          }
        }
      }
    },
