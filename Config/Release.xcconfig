// App Store and other release builds use the normal first-run onboarding state.
APP_ENVIRONMENT = production
SIMULATE_PRODUCTION_FLOW = NO
FORCE_ONBOARDING = NO
SEED_DEVELOPMENT_DATA = NO
SKIP_AUTH_LOGIN = NO
AUTH_BASE_URL = https:/$()/app.gatherory.com
GOOGLE_IOS_CLIENT_ID = 230060732276-qulnhq4cac5mrjrc9hk9l3qbo5jhe8pd.apps.googleusercontent.com
GOOGLE_IOS_REVERSED_CLIENT_ID = com.googleusercontent.apps.230060732276-qulnhq4cac5mrjrc9hk9l3qbo5jhe8pd
GOOGLE_SERVER_CLIENT_ID = 230060732276-2solr5ifutcsfnavjhd8t8nnc3jffha3.apps.googleusercontent.com
POSTHOG_PROJECT_TOKEN = phc_xPbBBJcQnKQBmZMeS49hS6KKrcsugidmPV7GEJTaBX7A
POSTHOG_HOST = https:/$()/us.i.posthog.com
// Independent of Debug; set to NO to disable telemetry in this configuration.
POSTHOG_ENABLED = YES
// Beta enables opt-in notifications; distribution provisioning and production APNs are required.
FCM_NOTIFICATIONS_ENABLED = YES
// Beta enables consent-gated production inventory; AdMob controls serving availability.
EXPLORE_ADS_ENABLED = YES
EXPLORE_ADS_TEST_MODE = NO
ADMOB_APP_ID = ca-app-pub-4218523458506277~8970323130
ADMOB_NATIVE_AD_UNIT_ID = ca-app-pub-4218523458506277/9237741437
APS_ENVIRONMENT = production
OTHER_LDFLAGS = $(inherited) -ObjC
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/Gatherory/Gatherory-Bridging-Header.h
